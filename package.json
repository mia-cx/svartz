{
  "name": "svartz-monorepo",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "description": "Svartz — SvelteKit-based site generator for Obsidian vaults",
  "repository": {
    "type": "git",
    "url": "https://github.com/mia-cx/svartz.git"
  },
  "scripts": {
    "svartz": "svartz",
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "test": "turbo test",
    "test:coverage": "turbo test:coverage",
    "release:check": "pnpm build && node scripts/check-release.mjs",
    "clean": "turbo clean && rm -rf node_modules",
    "add-license-headers": "node scripts/add-license-headers.mjs",
    "add-license-headers:dry": "node scripts/add-license-headers.mjs --dry-run",
    "svartz:build": "svartz run-managed-task svartz:build",
    "svartz:build:docs": "svartz build --vault docs",
    "svartz:dev:docs": "svartz dev --vault docs",
    "svartz:preview:docs": "svartz preview --vault docs",
    "svartz:build:showcase": "svartz build --vault showcase",
    "svartz:dev:showcase": "svartz dev --vault showcase",
    "svartz:preview:showcase": "svartz preview --vault showcase",
    "svartz:build:showcase-wiki": "svartz build --vault showcase-wiki",
    "svartz:dev:showcase-wiki": "svartz dev --vault showcase-wiki",
    "svartz:preview:showcase-wiki": "svartz preview --vault showcase-wiki",
    "svartz:build:showcase-blog": "svartz build --vault showcase-blog",
    "svartz:dev:showcase-blog": "svartz dev --vault showcase-blog",
    "svartz:preview:showcase-blog": "svartz preview --vault showcase-blog",
    "svartz:build:showcase-docs": "svartz build --vault showcase-docs",
    "svartz:dev:showcase-docs": "svartz dev --vault showcase-docs",
    "svartz:preview:showcase-docs": "svartz preview --vault showcase-docs",
    "svartz:dev": "turbo run svartz:dev:docs svartz:dev:showcase svartz:dev:showcase-wiki svartz:dev:showcase-blog svartz:dev:showcase-docs",
    "svartz:preview": "turbo run svartz:preview:docs svartz:preview:showcase svartz:preview:showcase-wiki svartz:preview:showcase-blog svartz:preview:showcase-docs"
  },
  "devDependencies": {
    "@svartz/config": "workspace:^",
    "@svartz/core": "workspace:^",
    "@svartz/theme-blog": "workspace:^",
    "@svartz/theme-docs": "workspace:^",
    "@svartz/theme-minimal": "workspace:^",
    "@svartz/theme-wiki": "workspace:^",
    "svartz": "workspace:^",
    "turbo": "^2.3.0"
  },
  "packageManager": "pnpm@9.14.2",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
