{
	"name": "@svartz/theme-mcp-docs",
	"version": "2.4.0",
	"description": "A Svartz theme for MCP server docs: tools, their schemas, annotations, and tools/call examples.",
	"license": "SEE LICENSE IN LICENSE",
	"publishConfig": { "access": "public" },
	"engines": { "node": "^20.19.0 || >=22.12.0" },
	"scripts": {
		"build": "svelte-kit sync && svelte-package && publint",
		"prepack": "svelte-kit sync && svelte-package && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/mia-cx/svartz.git",
		"directory": "themes/mcp-docs"
	},
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./runtime": {
			"types": "./dist/runtime.d.ts",
			"svelte": "./dist/runtime.js",
			"import": "./dist/runtime.js",
			"default": "./dist/runtime.js"
		}
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"dependencies": {
		"@svartz/core": "workspace:*",
		"@svartz/theme-minimal": "workspace:*",
		"@svartz/ui": "workspace:*"
	},
	"devDependencies": {
		"@svartz/theme-api-docs": "workspace:*",
		"@sveltejs/kit": "^3.3.1",
		"@sveltejs/package": "^3.0.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^24",
		"publint": "^0.3.17",
		"svelte": "^5.58.0",
		"svelte-check": "^4.7.8",
		"typescript": "^6.0.3",
		"vite": "^8.3.8",
		"vitest": "^4.1.12"
	}
}
