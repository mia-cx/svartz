{
  "name": "@svartz/vault",
  "version": "0.0.1",
  "type": "module",
  "description": "Obsidian vault traversal and metadata extraction for Svartz",
  "bin": {
    "svartz-vault": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./cli": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts --format esm --dts",
    "vault": "node /Users/mia/mia-cx/svartz/packages/vault/dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mia-cx/svartz.git",
    "directory": "packages/vault"
  },
  "keywords": [
    "obsidian",
    "vault",
    "markdown",
    "index",
    "wikilinks"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@svartz/config": "workspace:*",
    "commander": "^13.0.0",
    "effect": "^3.19.19",
    "gray-matter": "^4.0.3",
    "minimatch": "^10.1.1",
    "moment": "^2.30.1",
    "read-package-up": "^12.0.0"
  }
}
