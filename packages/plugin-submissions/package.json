{
  "name": "@svartz/plugin-submissions",
  "version": "2.5.0",
  "files": [
    "dist"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "type": "module",
  "description": "Readers edit or add a Svartz page from the site and get a GitHub pull request",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./server": {
      "import": "./dist/server.js",
      "types": "./dist/server.d.ts"
    },
    "./browser": {
      "import": "./dist/browser.js",
      "types": "./dist/browser.d.ts"
    },
    "./commits": {
      "import": "./dist/commits.js",
      "types": "./dist/commits.d.ts"
    },
    "./render": {
      "import": "./dist/render.js",
      "types": "./dist/render.d.ts"
    },
    "./restore": {
      "import": "./dist/restore.js",
      "types": "./dist/restore.d.ts"
    },
    "./browser.css": "./dist/browser.css"
  },
  "scripts": {
    "build": "tsup && node -e \"require('node:fs').copyFileSync('src/browser.css', 'dist/browser.css')\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mia-cx/svartz.git",
    "directory": "packages/plugin-submissions"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "SEE LICENSE IN LICENSE",
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/common": "^1.5.5",
    "@lezer/markdown": "^1.8.1",
    "@svartz/auth": "workspace:*",
    "@svartz/core": "workspace:*",
    "@svartz/plugins": "workspace:*",
    "hast-util-from-html": "^2.0.3"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/hast": "^3.0.4",
    "@types/node": "^22.0.0",
    "@vitest/browser-playwright": "^4.1.12",
    "miniflare": "^4.20260305.0",
    "playwright": "^1.58.2",
    "svartz": "workspace:*",
    "svelte": "^5.58.0",
    "tsup": "^8.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  }
}
