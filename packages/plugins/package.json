{
  "name": "@svartz/plugins",
  "version": "0.0.1",
  "type": "module",
  "description": "Core pipeline plugins for the Svartz build system",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
