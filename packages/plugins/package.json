{
  "name": "@svartz/plugins",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "type": "module",
  "description": "Core pipeline plugins for the Svartz build system",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./browser-analytics": {
      "import": "./dist/browser-analytics.js",
      "types": "./dist/browser-analytics.d.ts"
    },
    "./browser-mermaid": {
      "import": "./dist/browser-mermaid.js",
      "types": "./dist/browser-mermaid.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/browser-analytics.ts src/browser-mermaid.ts --format esm --dts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mia-cx/svartz.git",
    "directory": "packages/plugins"
  },
  "license": "SEE LICENSE IN LICENSE",
  "dependencies": {
    "@humanwhocodes/ico-to-png": "^1.1.0",
    "@svartz/core": "workspace:*",
    "effect": "^3.19.19",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "hast-util-to-html": "^9.0.5",
    "katex": "^0.18.9",
    "mdast-util-to-string": "^4.0.0",
    "mdsvex": "^0.12.6",
    "mermaid": "^11.17.2",
    "minimatch": "^10.1.1",
    "minisearch": "^7.2.0",
    "moment": "^2.30.1",
    "posthog-js": "^1.434.12",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-pretty-code": "^0.14.1",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "sharp": "^0.34.5",
    "shiki": "^1.26.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@types/hast": "^3.0.4",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "svelte": "^5.51.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0"
  }
}
