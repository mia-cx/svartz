{
  "name": "svartz",
  "version": "0.0.1",
  "publishConfig": {
    "access": "public"
  },
  "description": "Svartz CLI for building static Obsidian vault sites.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "svartz": "./dist/index.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/mia-cx/svartz.git"
  },
  "keywords": [
    "obsidian",
    "markdown",
    "site-generator",
    "sveltekit",
    "digital-garden"
  ],
  "license": "MIT",
  "dependencies": {
    "@svartz/config": "workspace:*",
    "@svartz/vite": "workspace:*",
    "chokidar": "^5.0.0",
    "commander": "^13.0.0",
    "effect": "^3.19.19",
    "vite": "^7.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.0.18",
    "tsup": "^8.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
