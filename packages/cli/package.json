{
  "name": "svartz",
  "version": "2.6.0",
  "publishConfig": {
    "access": "public"
  },
  "engines": { "node": "^22.17.0 || >=24.0.0" },
  "description": "Svartz CLI for building static Obsidian vault sites.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "svartz": "./dist/index.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "clean": "rm -rf dist",
    "test": "vitest run --no-file-parallelism",
    "test:coverage": "vitest run --coverage --no-file-parallelism"
  },
  "files": [
    "dist",
    "app",
    "template",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/mia-cx/svartz.git",
    "directory": "packages/cli"
  },
  "keywords": [
    "obsidian",
    "markdown",
    "site-generator",
    "sveltekit",
    "digital-garden"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "peerDependencies": {
    "tailwindcss": "^4.0.0",
    "vite": "^8.0.12"
  },
  "dependencies": {
    "@svartz/config": "workspace:*",
    "@svartz/ui": "workspace:*",
    "@svartz/vite": "workspace:*",
    "@sveltejs/adapter-cloudflare": "^8.0.3",
    "@sveltejs/adapter-node": "^6.0.4",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.3.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.3.5",
    "chokidar": "^5.0.0",
    "commander": "^13.0.0",
    "effect": "^3.19.19",
    "mdsvex": "^0.12.6",
    "svelte": "^5.58.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.1.12",
    "playwright": "^1.58.2",
    "tsup": "^8.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^4.1.12",
    "wrangler": "^4.164.0"
  }
}
