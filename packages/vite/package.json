{
  "name": "@svartz/vite",
  "version": "1.0.0",
  "publishConfig": { "access": "public" },
  "files": ["dist", "types"],
  "engines": { "node": "^20.19.0 || >=22.12.0" },
  "type": "module",
  "description": "Runtime-driven Vite integration for Svartz vault builds",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./virtual-modules": {
      "import": "./dist/virtual-modules.js",
      "types": "./types/virtual-modules.d.ts"
    },
    "./host": {
      "import": "./dist/host.js",
      "types": "./dist/host.d.ts"
    },
    "./discovery": {
      "import": "./dist/discovery.js",
      "types": "./dist/discovery.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/host.ts src/discovery.ts --format esm --dts && tsup src/virtual-modules.ts --format esm",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mia-cx/svartz.git",
    "directory": "packages/vite"
  },
  "license": "SEE LICENSE IN LICENSE",
  "dependencies": {
    "@svartz/core": "workspace:^",
    "@svartz/plugins": "workspace:^",
    "@svartz/theme-minimal": "workspace:*",
    "@tailwindcss/vite": "^4.2.2",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "effect": "^3.19.19",
    "jiti": "^2.7.0",
    "mrmime": "^2.0.1"
  },
  "peerDependencies": {
    "svelte": "^5.0.0",
    "vite": "^7.0.0 || ^8.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "svelte": "^5.51.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vite": "^7.3.1",
    "vitest": "^3.0.0"
  }
}
