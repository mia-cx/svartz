{
	"name": "@svartz/ui",
	"version": "1.0.0",
	"license": "SEE LICENSE IN LICENSE",
	"publishConfig": { "access": "public" },
	"engines": { "node": "^20.19.0 || >=22.12.0" },
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && svelte-kit sync && svelte-package && publint",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "svelte-kit sync && svelte-package && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "pnpm run test:unit -- --run",
		"test:coverage": "vitest run --coverage"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"main": "./dist/index.js",
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./runtime": {
			"types": "./dist/runtime/index.d.ts",
			"svelte": "./dist/runtime/index.js",
			"import": "./dist/runtime/index.js",
			"default": "./dist/runtime/index.js"
		},
		"./virtual-modules": {
			"types": "./dist/runtime/virtual-modules.d.ts"
		},
		"./base.css": "./dist/styles/base.css",
		"./tokens.css": "./dist/styles/tokens.css",
		"./syntax": {
			"types": "./dist/syntax.d.ts",
			"import": "./dist/syntax.js",
			"default": "./dist/syntax.js"
		},
		"./prose.css": "./dist/styles/prose.css"
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@eslint/compat": "^2.0.2",
		"@eslint/js": "^9.39.2",
		"@inlang/paraglide-js": "^2.10.0",
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/kit": "^2.50.2",
		"@sveltejs/package": "^2.5.7",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.1.18",
		"@types/node": "^24",
		"@vitest/browser-playwright": "^4.0.18",
		"@vitest/coverage-v8": "^4.0.18",
		"eslint": "^9.39.2",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.14.0",
		"globals": "^17.3.0",
		"playwright": "^1.58.2",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.4.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"publint": "^0.3.17",
		"svelte": "^5.51.0",
		"svelte-check": "^4.4.2",
		"tailwindcss": "^4.1.18",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.54.0",
		"vite": "^7.3.1",
		"vitest": "^4.0.18",
		"vitest-browser-svelte": "^2.0.2"
	},
	"keywords": [
		"svelte"
	],
	"dependencies": {
		"@svartz/core": "workspace:^",
		"@floating-ui/dom": "^1.7.4",
		"@fontsource-variable/geist-mono": "^5.3.0",
		"@fontsource-variable/instrument-sans": "^5.3.0",
		"@fontsource-variable/newsreader": "^5.3.0",
		"@lucide/svelte": "^1.48.0",
		"@nanostores/persistent": "^1.3.3",
		"@svartz/plugins": "workspace:*",
		"@types/d3": "^7.4.3",
		"d3": "^7.9.0",
		"minisearch": "^7.2.0",
		"nanostores": "^1.1.1",
		"shiki": "^1.26.2"
	}
}
