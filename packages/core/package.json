{
  "name": "@svartz/core",
  "version": "1.0.0",
  "publishConfig": { "access": "public" },
  "files": ["dist"],
  "engines": { "node": "^20.19.0 || >=22.12.0" },
  "type": "module",
  "description": "Shared types, plugin contract, and utilities for Svartz",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mia-cx/svartz.git",
    "directory": "packages/core"
  },
  "license": "MIT",
  "devDependencies": {
    "@vitest/coverage-v8": "^3.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "effect": "^3.19.19",
    "unified": "^11.0.5"
  }
}
