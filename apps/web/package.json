{
	"name": "@svartz/web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"vite:build": "vite build",
		"preview": "pnpm run build && wrangler dev",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "pnpm run test:unit -- --run",
		"test:coverage": "vitest run --coverage",
		"deploy": "pnpm run build && wrangler deploy",
		"cf-typegen": "wrangler types ./src/worker-configuration.d.ts"
	},
	"devDependencies": {
		"@eslint/compat": "^2.0.2",
		"@eslint/js": "^9.39.2",
		"@inlang/paraglide-js": "^2.10.0",
		"@svartz/ui": "workspace:*",
		"@sveltejs/adapter-auto": "^8.0.1",
		"@sveltejs/adapter-cloudflare": "^8.0.3",
		"@sveltejs/adapter-node": "^6.0.4",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.3.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.5",
		"@types/node": "^24.11.0",
		"@vitest/browser-playwright": "^4.1.12",
		"@vitest/coverage-v8": "^4.1.12",
		"eslint": "^9.39.2",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.14.0",
		"globals": "^17.3.0",
		"mdsvex": "^0.12.6",
		"playwright": "^1.58.1",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.4.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"svelte": "^5.58.0",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.1.18",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.73.0",
		"vite": "^8.3.8",
		"vitest": "^4.1.12",
		"vitest-browser-svelte": "^2.0.2",
		"wrangler": "^4.164.0"
	}
}
