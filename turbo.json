{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "src/**",
        "template/**",
        "*.config.js",
        "*.config.ts",
        "vite.config.ts",
        "svelte.config.js",
        "tsconfig.json",
        "package.json"
      ],
      "outputs": [
        "dist/**",
        ".svelte-kit/**",
        "build/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "inputs": [
        "src/**",
        "*.config.js",
        "*.config.ts",
        "package.json",
        "tsconfig.json"
      ]
    },
    "test": {
      "dependsOn": [
        "build"
      ],
      "inputs": [
        "src/**",
        "template/**",
        "package.json",
        "tsconfig.json",
        "vitest.config.*",
        "vite.config.*"
      ]
    },
    "test:coverage": {
      "dependsOn": [
        "build"
      ],
      "inputs": [
        "src/**",
        "package.json",
        "tsconfig.json",
        "vitest.config.*",
        "vite.config.*"
      ]
    },
    "clean": {
      "cache": false
    },
    "//#svartz:build": {
      "dependsOn": [
        "//#svartz:build:docs",
        "//#svartz:build:showcase",
        "//#svartz:build:showcase-wiki",
        "//#svartz:build:showcase-blog",
        "//#svartz:build:showcase-docs",
        "//#svartz:build:showcase-api",
        "//#svartz:build:showcase-reference"
      ]
    },
    "//#svartz:build:docs": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "packages/cli/app/**",
        "package.json",
        "pnpm-lock.yaml",
        "svartz.config.*",
        ".svartzrc.*",
        "vaults/docs/**"
      ],
      "outputs": [
        ".svartz/vaults/docs/.svelte-kit/cloudflare/**",
        ".svartz/vaults/docs/wrangler.json"
      ]
    },
    "//#svartz:dev:docs": {
      "cache": false,
      "persistent": true
    },
    "//#svartz:preview:docs": {
      "dependsOn": [
        "//#svartz:build:docs"
      ],
      "cache": false,
      "persistent": true
    },
    "//#svartz:build:showcase": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "packages/cli/app/**",
        "package.json",
        "pnpm-lock.yaml",
        "svartz.config.*",
        ".svartzrc.*",
        "vaults/showcase/**"
      ],
      "outputs": [
        ".svartz/vaults/showcase/.svelte-kit/cloudflare/**",
        ".svartz/vaults/showcase/wrangler.json"
      ]
    },
    "//#svartz:dev:showcase": {
      "cache": false,
      "persistent": true
    },
    "//#svartz:preview:showcase": {
      "dependsOn": [
        "//#svartz:build:showcase"
      ],
      "cache": false,
      "persistent": true
    },
    "//#svartz:build:showcase-wiki": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "packages/cli/app/**",
        "package.json",
        "pnpm-lock.yaml",
        "svartz.config.*",
        ".svartzrc.*",
        "vaults/showcase-wiki/**"
      ],
      "outputs": [
        ".svartz/vaults/showcase-wiki/.svelte-kit/cloudflare/**",
        ".svartz/vaults/showcase-wiki/wrangler.json"
      ]
    },
    "//#svartz:dev:showcase-wiki": {
      "cache": false,
      "persistent": true
    },
    "//#svartz:preview:showcase-wiki": {
      "dependsOn": [
        "//#svartz:build:showcase-wiki"
      ],
      "cache": false,
      "persistent": true
    },
    "//#svartz:build:showcase-blog": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "packages/cli/app/**",
        "package.json",
        "pnpm-lock.yaml",
        "svartz.config.*",
        ".svartzrc.*",
        "vaults/showcase-blog/**"
      ],
      "outputs": [
        ".svartz/vaults/showcase-blog/.svelte-kit/cloudflare/**",
        ".svartz/vaults/showcase-blog/wrangler.json"
      ]
    },
    "//#svartz:dev:showcase-blog": {
      "cache": false,
      "persistent": true
    },
    "//#svartz:preview:showcase-blog": {
      "dependsOn": [
        "//#svartz:build:showcase-blog"
      ],
      "cache": false,
      "persistent": true
    },
    "//#svartz:build:showcase-docs": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "packages/cli/app/**",
        "package.json",
        "pnpm-lock.yaml",
        "svartz.config.*",
        ".svartzrc.*",
        "vaults/showcase-docs/**"
      ],
      "outputs": [
        ".svartz/vaults/showcase-docs/.svelte-kit/cloudflare/**",
        ".svartz/vaults/showcase-docs/wrangler.json"
      ]
    },
    "//#svartz:dev:showcase-docs": {
      "cache": false,
      "persistent": true
    },
    "//#svartz:preview:showcase-docs": {
      "dependsOn": [
        "//#svartz:build:showcase-docs"
      ],
      "cache": false,
      "persistent": true
    },
    "//#svartz:build:showcase-api": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "packages/cli/app/**",
        "package.json",
        "pnpm-lock.yaml",
        "svartz.config.*",
        ".svartzrc.*",
        "vaults/showcase-api/**"
      ],
      "outputs": [
        ".svartz/vaults/showcase-api/.svelte-kit/cloudflare/**",
        ".svartz/vaults/showcase-api/wrangler.json"
      ]
    },
    "//#svartz:dev:showcase-api": {
      "cache": false,
      "persistent": true
    },
    "//#svartz:preview:showcase-api": {
      "dependsOn": [
        "//#svartz:build:showcase-api"
      ],
      "cache": false,
      "persistent": true
    },
    "//#svartz:build:showcase-reference": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "packages/cli/app/**",
        "package.json",
        "pnpm-lock.yaml",
        "svartz.config.*",
        ".svartzrc.*",
        "vaults/showcase-reference/**"
      ],
      "outputs": [
        ".svartz/vaults/showcase-reference/.svelte-kit/cloudflare/**",
        ".svartz/vaults/showcase-reference/wrangler.json"
      ]
    },
    "//#svartz:dev:showcase-reference": {
      "cache": false,
      "persistent": true
    },
    "//#svartz:preview:showcase-reference": {
      "dependsOn": [
        "//#svartz:build:showcase-reference"
      ],
      "cache": false,
      "persistent": true
    }
  },
  "globalDependencies": [
    ".env",
    "pnpm-lock.yaml"
  ]
}
