{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "src/**",
        "template/**",
        "*.config.js",
        "*.config.ts",
        "vite.config.ts",
        "svelte.config.js",
        "tsconfig.json",
        "package.json"
      ],
      "outputs": [
        "dist/**",
        ".svelte-kit/**",
        "build/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "inputs": [
        "src/**",
        "*.config.js",
        "*.config.ts",
        "package.json",
        "tsconfig.json"
      ]
    },
    "test": {
      "dependsOn": [
        "build"
      ],
      "inputs": [
        "src/**",
        "template/**",
        "package.json",
        "tsconfig.json",
        "vitest.config.*",
        "vite.config.*"
      ]
    },
    "test:coverage": {
      "dependsOn": [
        "build"
      ],
      "inputs": [
        "src/**",
        "package.json",
        "tsconfig.json",
        "vitest.config.*",
        "vite.config.*"
      ]
    },
    "clean": {
      "cache": false
    },
    "//#svartz:build": {
      "dependsOn": [
        "//#svartz:build:docs",
        "//#svartz:build:showcase",
        "//#svartz:build:showcase-wiki",
        "//#svartz:build:showcase-blog",
        "//#svartz:build:showcase-docs"
      ]
    },
    "//#svartz:build:docs": {
      "inputs": [
        "apps/web/**",
        "package.json",
        "pnpm-lock.yaml",
        "svartz.config.*",
        ".svartzrc.*",
        "vaults/docs/**"
      ],
      "outputs": [
        ".svartz/vaults/docs/dist/**"
      ]
    },
    "//#svartz:dev:docs": {
      "cache": false,
      "persistent": true
    },
    "//#svartz:preview:docs": {
      "dependsOn": [
        "//#svartz:build:docs"
      ],
      "cache": false,
      "persistent": true
    },
    "//#svartz:build:showcase": {
      "inputs": [
        "apps/web/**",
        "package.json",
        "pnpm-lock.yaml",
        "svartz.config.*",
        ".svartzrc.*",
        "vaults/showcase/**"
      ],
      "outputs": [
        ".svartz/vaults/showcase/dist/**"
      ]
    },
    "//#svartz:dev:showcase": {
      "cache": false,
      "persistent": true
    },
    "//#svartz:preview:showcase": {
      "dependsOn": [
        "//#svartz:build:showcase"
      ],
      "cache": false,
      "persistent": true
    },
    "//#svartz:build:showcase-wiki": {
      "inputs": [
        "apps/web/**",
        "package.json",
        "pnpm-lock.yaml",
        "svartz.config.*",
        ".svartzrc.*",
        "vaults/showcase-wiki/**"
      ],
      "outputs": [
        ".svartz/vaults/showcase-wiki/dist/**"
      ]
    },
    "//#svartz:dev:showcase-wiki": {
      "cache": false,
      "persistent": true
    },
    "//#svartz:preview:showcase-wiki": {
      "dependsOn": [
        "//#svartz:build:showcase-wiki"
      ],
      "cache": false,
      "persistent": true
    },
    "//#svartz:build:showcase-blog": {
      "inputs": [
        "apps/web/**",
        "package.json",
        "pnpm-lock.yaml",
        "svartz.config.*",
        ".svartzrc.*",
        "vaults/showcase-blog/**"
      ],
      "outputs": [
        ".svartz/vaults/showcase-blog/dist/**"
      ]
    },
    "//#svartz:dev:showcase-blog": {
      "cache": false,
      "persistent": true
    },
    "//#svartz:preview:showcase-blog": {
      "dependsOn": [
        "//#svartz:build:showcase-blog"
      ],
      "cache": false,
      "persistent": true
    },
    "//#svartz:build:showcase-docs": {
      "inputs": [
        "apps/web/**",
        "package.json",
        "pnpm-lock.yaml",
        "svartz.config.*",
        ".svartzrc.*",
        "vaults/showcase-docs/**"
      ],
      "outputs": [
        ".svartz/vaults/showcase-docs/dist/**"
      ]
    },
    "//#svartz:dev:showcase-docs": {
      "cache": false,
      "persistent": true
    },
    "//#svartz:preview:showcase-docs": {
      "dependsOn": [
        "//#svartz:build:showcase-docs"
      ],
      "cache": false,
      "persistent": true
    }
  },
  "globalDependencies": [
    ".env",
    "pnpm-lock.yaml"
  ]
}
